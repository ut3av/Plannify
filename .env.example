# Backend Configuration
BACKEND_PORT=8080
PORT=8080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Automation (Make.com / Integromat)
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_make_webhook_url_here
MAKE_SECRET=your_make_secret_here

# Database Configuration (Supabase Backend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Frontend Configuration (.env at root)
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here
REACT_APP_API_URL=http://localhost:8080
